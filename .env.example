# Copy to .env (git-ignored) and fill in. Loaded via python-dotenv.

# AWS — least-privilege IAM user for the auction lake silo (see infra/aws/)
AWS_PROFILE=tributary
TRIBUTARY_S3_BUCKET=tributary-auction-lake-<yoursuffix>

# GCP — BigQuery marketing silo (uses application-default credentials;
# run: gcloud auth application-default login)
GCP_PROJECT_ID=
BQ_MARKETING_DATASET=marketing

# Neon/Supabase Postgres — CRM silo
CRM_DATABASE_URL=postgresql://user:password@host/dbname
