*.pyc
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# dbt
warehouse/target/
warehouse/dbt_packages/
warehouse/logs/

# Tooling
.DS_Store
.duckdb
*.duckdb.wal
